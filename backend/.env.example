# =========================================================
# Shriram Binary System — Environment Variables Template
# =========================================================
# Copy this file to .env and fill in your actual values.
# =========================================================

# MongoDB Connection
MONGODB_URI=mongodb://your_username:your_password@your_host:27017/your_database?ssl=true&authSource=admin&retryWrites=true&w=majority

# Server Port
PORT=5000

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
